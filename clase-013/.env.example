 
 
 FIREBASE_API_KEY: #tus claves de firebases
 FIREBASE_AUTH_DOMAIN: #tus claves de firebases
 FIREBASE_PROJECT_ID: #tus claves de firebases
 FIREBASE_STORAGE_BUCKET: #tus claves de firebases
 FIREBASE_MESSAGING_SENDER_ID: #tus claves de firebases
 FIREBASE_APP_ID: #tus claves de firebases
 FIREBASE_MEASUREMENT_ID: #tus claves de firebases


 apiKey: process.env.FIREBASE_API_KEY,
        authDomain: process.env.FIREBASE_AUTH_DOMAIN,
        projectId: process.env.FIREBASE_PROJECT_ID,
        storageBucket: process.env.FIREBASE_STORAGE_BUCKET,
        messagingSenderId: process.env.FIREBASE_MESSAGING_SENDER_ID,
        appId: process.env.FIREBASE_APP_ID,
        measurementId: process.env.FIREBASE_MEASUREMENT_ID